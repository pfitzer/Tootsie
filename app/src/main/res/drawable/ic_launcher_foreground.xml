<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tootsie "T" Logo -->
    <!-- Large cyan T shape in the center -->
    <group
        android:translateX="54"
        android:translateY="54">

        <!-- Main T horizontal bar -->
        <path
            android:fillColor="#7FE5DD"
            android:pathData="M-25,-10 L25,-10 L25,5 L-25,5 Z" />

        <!-- Main T vertical stem -->
        <path
            android:fillColor="#7FE5DD"
            android:pathData="M-8,5 L8,5 L8,30 L-8,30 Z" />

        <!-- Orange outline accent - top right -->
        <path
            android:fillColor="#E89A7C"
            android:fillType="nonZero"
            android:pathData="M20,-15 L28,-15 L28,-8 L20,-8 Z" />

        <!-- Orange outline accent - bottom left -->
        <path
            android:fillColor="#E89A7C"
            android:fillType="nonZero"
            android:pathData="M-12,25 L-4,25 L-4,35 L-12,35 Z" />

        <!-- Cyan geometric shapes -->
        <!-- Small circle top left -->
        <path
            android:fillColor="#7FE5DD"
            android:pathData="M -28,-5 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0" />

        <!-- Small circle bottom right -->
        <path
            android:fillColor="#E89A7C"
            android:pathData="M 28,20 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0" />

        <!-- Small triangle top right -->
        <path
            android:fillColor="#E89A7C"
            android:pathData="M 22,-8 L 26,-8 L 24,-4 Z" />

        <!-- Small triangle bottom -->
        <path
            android:fillColor="#E89A7C"
            android:pathData="M -5,32 L -1,32 L -3,36 Z" />

        <!-- Outline frame elements -->
        <!-- Top horizontal line (orange) -->
        <path
            android:strokeColor="#E89A7C"
            android:strokeWidth="1.5"
            android:pathData="M -30,-12 L 10,-12" />

        <!-- Right vertical line (cyan) -->
        <path
            android:strokeColor="#7FE5DD"
            android:strokeWidth="1.5"
            android:pathData="M 28,-10 L 28,25" />

        <!-- Left vertical line (orange) -->
        <path
            android:strokeColor="#E89A7C"
            android:strokeWidth="1.5"
            android:pathData="M -30,-8 L -30,28" />

        <!-- Bottom horizontal line (cyan) -->
        <path
            android:strokeColor="#7FE5DD"
            android:strokeWidth="1.5"
            android:pathData="M -25,32 L 25,32" />
    </group>
</vector>
