<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Exclude legacy encrypted prefs (deleted on first start since #179): Android Keystore keys are device-bound and cannot be
            restored from cloud, so restoring the file would produce unreadable data.
        -->
        <exclude domain="sharedpref" path="tootsie_secure_prefs.xml" />

        <!--
            Exclude DataStore: contains VAPID private keys for push notifications.
            After restore the user must re-authenticate anyway.
        -->
        <exclude domain="file" path="datastore/" />

        <!--
            Exclude Room database: access tokens are encrypted with a device-bound
            Android Keystore key and could not be decrypted after a restore.
        -->
        <exclude domain="database" path="tootsie_database" />
        <exclude domain="database" path="tootsie_database-wal" />
        <exclude domain="database" path="tootsie_database-shm" />
    </cloud-backup>

    <device-transfer>
        <!-- Same exclusions apply for device-to-device transfer -->
        <exclude domain="sharedpref" path="tootsie_secure_prefs.xml" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="tootsie_database" />
        <exclude domain="database" path="tootsie_database-wal" />
        <exclude domain="database" path="tootsie_database-shm" />
    </device-transfer>
</data-extraction-rules>
